{
  "name": "klassa-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Tài liệu hướng dẫn sử dụng KLASSA cho khách hàng",
  "scripts": {
    "docs:dev": "vitepress dev --port 5180",
    "docs:build": "vitepress build && node scripts/postbuild.mjs",
    "docs:preview": "vitepress preview --port 5181",
    "capture": "tsx scripts/capture-screenshots.ts",
    "capture:headed": "tsx scripts/capture-screenshots.ts --headed",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@playwright/test": "^1.45.0",
    "markdown-it-container": "^4.0.0",
    "medium-zoom": "^1.1.2",
    "playwright": "^1.45.0",
    "sharp": "^0.34.4",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitepress": "^1.6.4"
  }
}
